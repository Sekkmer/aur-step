# Required unless AUR_STEP_BUILD_USER or SUDO_USER supplies it.
build_user = "alice"

# Optional. Defaults are derived from the build user's passwd entry.
# build_root = "/home/alice/aurbuild"
# yay_build_dir = "/home/alice/.cache/yay"

# Build PKGBUILDs in bubblewrap with a dedicated empty HOME by default.
# Source verification gets network access; the actual build does not unless
# explicitly enabled for packages such as VCS builds.
# sandbox_builds = true
# allow_build_network = false
# sandbox_home = "/home/alice/aurbuild/.aur-step-home"

# Optional trusted root state and AUR endpoint.
# state_db = "/var/lib/aur-step/state.sqlite3"
# aur_url = "https://aur.archlinux.org"
